# Optional. Copy to .env (git-ignored) to set these without typing them every time.
# Every line is optional: with no .env at all, GraftChat asks for the key in Settings.
# A variable already set in your shell wins over this file.

# Your OpenRouter key (https://openrouter.ai/keys). Leave it empty to paste it in
# Settings, or use "Connect OpenRouter" there instead. If set here, the UI cannot change it.
OPENROUTER_API_KEY=

# Port of the local server (default 8000).
# GRAFTCHAT_PORT=8000

# Folder of the settings file and the database (default: ~/.graftchat, outside the repo).
# GRAFTCHAT_HOME=

# SQLite file (default: <GRAFTCHAT_HOME>/graftchat.db).
# GRAFTCHAT_DB=

# 1 = canned local answers: no key, no network, no cost. For trying the interface.
# GRAFTCHAT_FAKE_LLM=0

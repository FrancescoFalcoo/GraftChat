# Copy to .env and fill in. .env is git-ignored: never commit a real key (DESIGN.md §5).
# Used by api/ and experiments/ during development. In the app the user pastes
# their own key (BYOK): it is stored locally and sent only to the provider.

# Provider (v1: OpenRouter only). Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Models: chat on main/branches, and the lighter model for take-aways (§8).
# Both are free (":free") and support structured JSON output (response_format).
# Avoid "openrouter/free": it routes to a random free model on each call,
# which makes runs non-reproducible.
GRAFTCHAT_CHAT_MODEL=google/gemma-4-31b-it:free
GRAFTCHAT_TAKEAWAY_MODEL=google/gemma-4-26b-a4b-it:free

# Hard monthly spend cap in USD, enforced client-side (§4).
# Free models cost 0, but the same key can also call paid models.
GRAFTCHAT_MONTHLY_SPEND_CAP_USD=10

# SQLite database file (§6)
GRAFTCHAT_DB_PATH=graftchat.db
